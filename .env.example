# ── Identidad ────────────────────────────────────────────────────────────────
# Nombre visible del sitio (el "/" solo aparece aquí, en texto visible)
SITE_NAME="dev/null"

# ── PostgreSQL 16 (Docker Compose) ────────────────────────────────────────────
# Credenciales usadas por el servicio db en docker-compose.yml
POSTGRES_USER=devnull
POSTGRES_PASSWORD=cambia_esto_por_una_password_segura
POSTGRES_DB=devnull

# Puerto local donde se publica PostgreSQL (127.0.0.1 únicamente)
# Cambia si ya tienes un Postgres local en el 5432
DB_PORT=5432

# Cadena de conexión para la API (en desarrollo apunta a localhost; en contenedor apunta a "db")
DATABASE_URL=postgresql+asyncpg://devnull:cambia_esto_por_una_password_segura@127.0.0.1:5432/devnull

# ── Redis (Docker Compose) ────────────────────────────────────────────────────
# Puerto local donde se publica Redis (127.0.0.1 únicamente)
# Cambia si ya tienes un Redis local en el 6379
REDIS_PORT=6379

# URL de conexión para la API (en desarrollo apunta a localhost; en contenedor apunta a "redis")
REDIS_URL=redis://127.0.0.1:6379/0

# ── API (Docker Compose) ──────────────────────────────────────────────────────
# Puerto local donde se publica la API cuando se usa --profile app
# Cambia si el 8000 está ocupado
API_PORT=8000

# ── Autenticación / JWT ───────────────────────────────────────────────────────
# Secreto para firmar access tokens (15 min de vida)
JWT_SECRET=cambia_esto_por_un_secreto_seguro

# Secreto para firmar refresh tokens (7 días, cookie httpOnly)
REFRESH_SECRET=cambia_esto_por_otro_secreto_seguro

# ── Métricas ──────────────────────────────────────────────────────────────────
# Salt para el HMAC de huellas de visitante (nunca se guarda la IP)
METRICS_SALT_SECRET=cambia_esto_por_un_salt_seguro

# ── Revalidación ISR ──────────────────────────────────────────────────────────
# Secreto compartido entre la API y Next.js para el webhook de revalidación
REVALIDATE_SECRET=cambia_esto_por_un_secreto_de_revalidacion

# ── Cookies ───────────────────────────────────────────────────────────────────
# true en producción (HTTPS), false en desarrollo local
COOKIE_SECURE=false

# ── Proxy inverso ─────────────────────────────────────────────────────────────
# true solo si la API NO es accesible sin pasar por Caddy/Next.js (X-Forwarded-For es falseable).
TRUST_PROXY_HEADERS=false
# Proxies de confianza encadenados delante de la API (Caddy = 1; Caddy + Next.js = 2).
TRUSTED_PROXY_HOPS=1

# ── URLs de servicios ─────────────────────────────────────────────────────────
# URL interna del frontend Next.js (para que la API llame al webhook de revalidación)
WEB_URL=http://localhost:3000

# ── Almacenamiento ────────────────────────────────────────────────────────────
# Ruta al directorio local de media (volumen Docker en producción)
MEDIA_DIR=./media

# ── Entorno ───────────────────────────────────────────────────────────────────
# Valores: development | production (en producción los secretos deben tener ≥ 32 caracteres,
# ser distintos entre sí y COOKIE_SECURE=true; si no, la API no arranca)
ENV=development

# ── Blog público (Next.js) ────────────────────────────────────────────────────
# URL pública del blog (canonical, RSS, sitemap). La API también la usa para detectar
# referrers internos. En desarrollo, copia web/.env.example a web/.env.local.
SITE_URL=http://localhost:3000
