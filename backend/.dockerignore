# Archivos excluidos del contexto de build de Docker

# Entornos virtuales
.venv/
venv/
env/

# Caché de Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Herramientas de desarrollo
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Variables de entorno (nunca en la imagen)
.env
.env.*
!.env.example

# Control de versiones
.git/
.gitignore

# Tests (no necesarios en la imagen de producción)
tests/

# IDEs
.vscode/
.idea/

# Temporales
*.log
*.tmp
tmp/
