{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "admin",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "admin", "dev"],
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "web", "dev"],
      "port": 3000
    }
  ]
}
